# shellcheck shell=bash
PYTHONWARNINGS="ignore:setup.py install is deprecated::setuptools.command.install"; export PYTHONWARNINGS
bind '"\e[A":history-search-backward'
bind '"\e[B":history-search-forward'
export CODING_DIR="$HOME/Coding"
export NIX_DIR="${NIX_DIR:-$HOME/nixos-config}"

# The body runs in a subshell, so its cd never leaks into the calling shell.
update_all() (
  local answer safe_gen new_gen do_upgrade flake_target untracked

  do_upgrade=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --upgrade)
        do_upgrade=1
        ;;
      -h|--help)
        cat <<'EOF2'
Usage: update_all [--upgrade]

  --upgrade  Run `nix flake update` before rebuilding.
EOF2
        return 0
        ;;
      *)
        echo "Unknown option: $1"
        echo "Usage: update_all [--upgrade]"
        return 1
        ;;
    esac
    shift
  done

  # Require sudo upfront
  sudo -v || return 1

  # ── 0. Show current state before doing anything ──────────────────────────
  echo -e "\n=== Current system generations ==="
  sudo nix-env --list-generations --profile /nix/var/nix/profiles/system
  safe_gen=$(sudo nix-env --list-generations --profile /nix/var/nix/profiles/system \
    | grep current | awk '{print $1}')
  echo -e "\n>>> Safe/current generation: $safe_gen (will never be deleted) <<<\n"

  # ── 1. Optionally update flake ───────────────────────────────────────────
  cd "$NIX_DIR" || return 1
  if [ "$do_upgrade" -eq 1 ]; then
    echo -e "\nUpdating Nix flake..."
    if ! nix flake update; then
      echo "nix flake update failed"
      return 1
    fi
  else
    echo -e "\nSkipping flake update (pass --upgrade to refresh flake.lock)."
  fi

  # The system is built straight from this repo. Nothing is copied to /etc/nixos.
  flake_target="${NIX_DIR}#$(hostname)"

  # ── 2. Warn about files the flake cannot see ─────────────────────────────
  # A flake build only reads git-tracked files. A new file is invisible to the
  # rebuild until it is added, even without a commit.
  if git -C "$NIX_DIR" rev-parse --git-dir >/dev/null 2>&1; then
    untracked=$(git -C "$NIX_DIR" ls-files --others --exclude-standard)
    if [ -n "$untracked" ]; then
      echo -e "\nThese files are not tracked by git, so the rebuild will ignore them:"
      echo "$untracked" | sed 's/^/  /'
      echo "Run 'git add' on them first if the config needs them."
      read -r -p "Continue anyway? [y/N] " answer
      case "$answer" in
        [yY][eE][sS]|[yY]) ;;
        *) return 1 ;;
      esac
    fi
  fi

  # ── 3. Build, activate for this session, then ask ────────────────────────
  echo -e "\nBuilding and testing new configuration..."
  echo "NOTE: If this fails or the desktop breaks, just reboot — the previous generation is safe."
  if ! sudo nixos-rebuild test --flake "$flake_target" --show-trace; then
    echo ""
    echo "nixos-rebuild test failed. No changes have been made to your boot configuration."
    echo "Your system is still on generation $safe_gen."
    return 1
  fi

  # ── 4. Confirm before making it the boot default ─────────────────────────
  echo ""
  echo "Build succeeded and new config is now active in this session."
  echo "Check that everything works (display manager, apps, etc.) before continuing."
  echo ""
  read -r -p "Make this the default boot generation? [y/N] " answer
  case "$answer" in
    [yY][eE][sS]|[yY])
      if ! sudo nixos-rebuild switch --flake "$flake_target" --show-trace; then
        echo "nixos-rebuild switch failed. Rebooting will return you to generation $safe_gen."
        return 1
      fi
      ;;
    *)
      echo ""
      echo "Keeping generation $safe_gen as boot default."
      echo "The new config is active in this session only — reboot to go back to gen $safe_gen."
      return 0
      ;;
  esac

  # ── 5. Show new generation state ─────────────────────────────────────────
  # No cleanup here. boot.loader.systemd-boot.configurationLimit caps the boot
  # entries, and nix.gc deletes generations older than 30 days every week.
  new_gen=$(sudo nix-env --list-generations --profile /nix/var/nix/profiles/system \
    | grep current | awk '{print $1}')
  echo -e "\nUpdate complete! New generation: $new_gen | Previous safe generation was: $safe_gen"
  echo "To reclaim space now: sudo nix-collect-garbage -d"
)

validate_nix_config() (
  cd "$NIX_DIR" || return 1

  echo -e "\nChecking shell scripts..."
  nix run nixpkgs#shellcheck -- --severity=warning install.sh dots/bashrc || return 1

  echo -e "\nChecking flake outputs..."
  nix flake check || return 1

  echo -e "\nChecking compatibility entrypoints..."
  nix-instantiate --eval default.nix >/dev/null || return 1
  nix-instantiate --eval shell.nix >/dev/null || return 1

  echo -e "Validation complete!"
)

# Start, stop or show one tunnel from vpn/regions.nix: vpn start it
vpn() {
  case "$1" in
    start | stop) sudo systemctl "$1" "vpn-$2.service" ;;
    status) systemctl status "vpn-$2.service" ;;
    *)
      echo "Usage: vpn start|stop|status <region>"
      return 1
      ;;
  esac
}

alias update-all='update_all'
alias validate-nix-config='validate_nix_config'

alias claudio='claude --remote-control --dangerously-skip-permissions --chrome'

alias cdn='cd $NIX_DIR'
alias cdc='cd $CODING_DIR'
# Mappings are applied by default now (--use-mappings is gone). A Bilancio*.xlsx
# in ~/Downloads is picked up automatically and merged into the saved mappings.
# Runs in a subshell so the cd does not leak into the current shell.
alias format-bank-excels='(cd $CODING_DIR/python && python3 -m unified_bank_statement -i ~/Downloads/ --history --auto)'
alias format-bank-excels-preview='(cd $CODING_DIR/python && python3 -m unified_bank_statement -i ~/Downloads/ --history --auto --dry-run)'

# Point SSH at the gpg-agent socket. This is the only place the variable is
# set: Home Manager writes its own session variables to ~/.profile, and a GDM
# session never runs a login shell, so that file is dead here.
SSH_AUTH_SOCK=$(gpgconf --list-dirs agent-ssh-socket)
export SSH_AUTH_SOCK

# Tell GPG which terminal window to use for the password popup
if tty -s; then
  GPG_TTY=$(tty)
  export GPG_TTY
  gpg-connect-agent updatestartuptty /bye > /dev/null 2>&1
fi

forgit() {
  local dir

  for dir in */; do
    [ -d "$dir" ] || continue
    (
      cd "$dir" || exit 1
      echo -e "----$dir-----"
      git "$@"
    )
  done
}

suspend_sleep()
{
  systemd-inhibit --what=idle:sleep --why="Long-running session" bash
}

recursive_replace()
{
  local scope search replace

  if [ $# -eq 2 ]; then
    scope="./"
    search="$1"
    replace="$2"
  elif [ $# -eq 3 ]; then
    scope="$1"
    search="$2"
    replace="$3"
  else
    echo -e "Illegal number of arguments"
    return 1
  fi

  if [ ! -e "$scope" ]; then
    echo -e "Path not found: $scope"
    return 1
  fi

  grep -rFlZ --exclude-dir='.git' -- "$search" "$scope" |
    xargs -0r env SEARCH="$search" REPLACE="$replace" perl -0pi -e 's/\Q$ENV{SEARCH}\E/$ENV{REPLACE}/g'
}
